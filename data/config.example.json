{
  "system": {
    "os": "linux" 
  },
  "hardware": {
    "gps_port": "/dev/ttyACM0",
    "gps_baudrate": 115200,
    "arduino_dac_port": "/dev/ttyACM3",
    "arduino_dac_baudrate": 115200
  },
  "gnss": {
    "_uitleg": "ArduSimple simpleRTK4 Dual (u-blox ZED-X20D): 1 ontvanger, 2 antennes, 1 seriele poort. Koers komt uit NMEA THS (moving baseline GPS1->GPS2).",
    "heading_offset_deg": 0.0,
    "antenna_offset_forward_m": 0.0,
    "antenna_offset_right_m": 0.0,
    "heading_timeout_s": 1.0,
    "vtg_fallback_min_kmh": 1.5,
    "accept_estimated_heading": true
  },
  "vehicle": {
    "track_width_m": 0.85,
    "min_turn_radius_m": 0.85,
    "max_yaw_rate_dps": 45.0
  },
  "motor_control": {
    "speed_table_path": "setup/information/throttle_dac_speed_table.json",
    "dac_stop": 700,
    "dac_min_start": 1200,
    "dac_max": 3100,
    "creep_threshold_mps": 0.12,
    "max_accel_mps2": 0.6,
    "max_decel_mps2": 1.5,
    "smoothing_interval_sec": 0.05,
    "command_timeout_sec": 2.0
  },
  "navigation": {
    "lookahead_distance_m": 3.0,
    "arrival_threshold_intermediate_m": 0.8,
    "arrival_threshold_final_m": 0.8,
    "turn_speed_kmh": 2.0,
    "turn_heading_tolerance_deg": 8.0,
    "turn_timeout_s": 40.0,
    "spot_turn_threshold_deg": 60.0,
    "spot_turn_yaw_rate_dps": 25.0,
    "loop_rate_hz": 20.0,
    "min_fix_quality": 2
  },
  "ntrip": {
    "host": "caster.centipede.fr",
    "port": 2101,
    "mountpoint": "NEAR",
    "user": "centipede",
    "pass": "centipede",
    "gga_interval_s": 10.0
  },
  "vision": {
    "camera_type": "gx",
    "gx_camera": {
      "index": 1,
      "fps": 15,
      "exposure_min_us": 100,
      "exposure_max_us": 500,
      "gain_min_db": 0,
      "gain_max_db": 16
    },
    "usb_camera": {
      "index": 0,
      "width": 800,
      "height": 600,
      "fps": 100
    },
    "rtsp_streams": [
      "rtsp://url"
    ],
    "yolo_model_path": "weights/Rumex.pt",
    "confidence_threshold": 0.4,
    "trigger_lijn_y_percentage": 0.60, 
    "zones_aantal": 6,
    "zone_offsets_meters": [-0.5, -0.3, -0.1, 0.1, 0.3, 0.5] 
  }
}